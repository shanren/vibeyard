{
  "model": "sonnet",
  "permissionMode": "acceptEdits",
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Agent",
      "Bash(git *)",
      "Bash(npm *)",
      "Bash(pnpm *)",
      "Bash(yarn *)",
      "Bash(python *)",
      "Bash(go *)",
      "Bash(cargo *)",
      "Bash(node *)",
      "Bash(npx *)",
      "Bash(mkdir *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(cd *)",
      "Bash(echo *)",
      "Bash(cp *)",
      "Bash(mv *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -rf .*)",
      "Bash(sudo *)",
      "Bash(chmod 777 *)",
      "Bash(git push --force)",
      "Bash(git push --force-with-lease)",
      "Bash(git push origin main --force)",
      "Bash(drop database *)",
      "Bash(dropdb *)",
      "Bash(truncate table *)",
      "Bash(mv /*)",
      "Bash(mv ./*)",
      "Bash(:(){ :|:& };:)",
      "Bash(> /dev/sda)",
      "Bash(curl * | sh)",
      "Bash(wget * -O - | sh)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "allowedPaths": [
      "./src",
      "./tests",
      "./sandbox",
      "./docs",
      "./scripts",
      "./.claude"
    ],
    "forbiddenPaths": [
      "/etc",
      "/var",
      "~/.ssh",
      "~/.aws",
      "~/.gcloud",
      "~/.azure"
    ]
  },
  "telemetry": false
}
